{
  "$comment": "The one declaration of every external binary the gates need. preflight.mjs verifies it before any check runs; toolchain.test.mjs fails when a tool here is not provisioned by the CI job that runs its tier. Adding a gate dependency without teaching CI about it breaks the gate locally first.",
  "tiers": {
    "quick": {
      "job": "quick",
      "description": "source and fixture feedback"
    },
    "check": {
      "job": "full-corpus",
      "description": "pinned tree, rebuilt index, corpus gates"
    },
    "release": {
      "job": "extended-toolchain",
      "description": "Doxygen API, compile matrix, clean room"
    }
  },
  "tools": [
    {
      "command": "node",
      "tier": "quick",
      "versionArgs": [
        "--version"
      ],
      "minimum": "24.0.0",
      "provisionedBy": "actions/setup-node",
      "install": "Install Node.js 24 or newer."
    },
    {
      "command": "claude",
      "tier": "quick",
      "versionArgs": [
        "--version"
      ],
      "provisionedBy": "@anthropic-ai/claude-code",
      "install": "npm install -g @anthropic-ai/claude-code"
    },
    {
      "command": "git",
      "tier": "quick",
      "versionArgs": [
        "--version"
      ],
      "provisionedBy": "actions/checkout",
      "install": "Install git."
    },
    {
      "command": "python3",
      "tier": "quick",
      "versionArgs": [
        "--version"
      ],
      "minimum": "3.12.0",
      "provisionedBy": "actions/setup-python",
      "install": "Install Python 3.12 or newer, or set PYTHON_EXECUTABLE.",
      "$comment": "check:quick runs python.test.mjs, which probes for a real interpreter. Declared quick, not check."
    },
    {
      "command": "doxygen",
      "tier": "release",
      "versionArgs": [
        "--version"
      ],
      "exact": "1.15.0",
      "provisionedBy": "doxygen/doxygen",
      "install": "curl -fsSL https://github.com/doxygen/doxygen/releases/download/Release_1_15_0/doxygen-1.15.0.linux.bin.tar.gz | tar -xz && sudo install doxygen-1.15.0/bin/doxygen /usr/local/bin/doxygen",
      "$comment": "Exact, not a minimum, because scripts/quality/fixtures/baseline-counts-semantic.json records the API counts this Doxygen produces and counts.mjs compares them exactly. 1.9.8 finds 84919 symbols where 1.15.0 finds 84934; both are defensible readings of the same headers, but only one matches the fixture. apt-get cannot serve this: it ships whatever the distribution froze."
    },
    {
      "command": "cmake",
      "tier": "release",
      "versionArgs": [
        "--version"
      ],
      "provisionedBy": "apt-get",
      "install": "sudo apt-get install --yes cmake"
    },
    {
      "command": "ninja",
      "tier": "release",
      "versionArgs": [
        "--version"
      ],
      "provisionedBy": "apt-get",
      "install": "sudo apt-get install --yes ninja-build"
    },
    {
      "command": "dtc",
      "tier": "release",
      "versionArgs": [
        "--version"
      ],
      "provisionedBy": "apt-get",
      "install": "sudo apt-get install --yes device-tree-compiler"
    },
    {
      "command": "gperf",
      "tier": "release",
      "versionArgs": [
        "--version"
      ],
      "provisionedBy": "apt-get",
      "install": "sudo apt-get install --yes gperf"
    },
    {
      "command": "west",
      "tier": "release",
      "versionArgs": [
        "--version"
      ],
      "provisionedBy": "pip",
      "install": "python -m pip install -r .cache/zephyr/scripts/requirements-base.txt"
    },
    {
      "command": "esptool",
      "tier": "release",
      "versionArgs": [
        "version"
      ],
      "provisionedBy": "pip",
      "install": "python -m pip install \"esptool>=5.0.2\""
    }
  ]
}
